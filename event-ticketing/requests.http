### Event Ticketing — Ordering API
# Install the "REST Client" VS Code extension (publisher: Huachao Mao)
# Click "Send Request" above each request, or Ctrl+Alt+R while cursor is inside a block
# Responses from named requests (# @name xxx) can be referenced via {{xxx.response.body.$.field}}

@baseUrl = http://localhost:3000
@contentType = application/json

# Seeded in FakeEventAvailabilityChecker
@openEvent = evt-rock-festival
@closedEvent = evt-closed-concert
@vipTicket = ticket-vip
@generalTicket = ticket-general
@soldOutTicket = ticket-sold-out
@attendeeId = att-1


###############################################################################
# HAPPY PATH — full lifecycle
###############################################################################


### 1. Create an order (reserve tickets) — 201 Created
# @name createOrder
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": [
    { "ticketTypeId": "{{vipTicket}}", "quantity": 2, "unitPrice": 5000 }
  ]
}


### 2. List orders for this attendee — 200 OK
GET {{baseUrl}}/orders?attendeeId={{attendeeId}}


### 3. Pay the order from #1 — 200 OK
# Uses the id captured from request #1
@orderId = {{createOrder.response.body.id}}

POST {{baseUrl}}/orders/{{orderId}}/pay
Content-Type: {{contentType}}

{
  "paymentToken": "tok_test_success_123",
  "paymentMethod": "credit_card"
}


### 4. Setup — create a fresh order so the next request can cancel it
# @name createForCancel
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": [
    { "ticketTypeId": "{{generalTicket}}", "quantity": 1, "unitPrice": 3000 }
  ]
}


### 5. Cancel the order from #4 with a reason — 200 OK
POST {{baseUrl}}/orders/{{createForCancel.response.body.id}}/cancel
Content-Type: {{contentType}}

{
  "reason": "changed my mind"
}


### 6. Setup — create another fresh order to test cancel without a reason
# @name createForCancelNoReason
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": [
    { "ticketTypeId": "{{generalTicket}}", "quantity": 1, "unitPrice": 3000 }
  ]
}


### 7. Cancel the order from #6 with an empty body — 200 OK, reason ends up null
POST {{baseUrl}}/orders/{{createForCancelNoReason.response.body.id}}/cancel
Content-Type: {{contentType}}

{}


###############################################################################
# UNHAPPY PATHS — these should all fail with specific errors
###############################################################################


### 8. Create an order for a closed event — 409 EventNotAvailable
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{closedEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": [
    { "ticketTypeId": "{{vipTicket}}", "quantity": 1, "unitPrice": 5000 }
  ]
}


### 9. Create an order for a sold-out ticket — 409 InsufficientTickets
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": [
    { "ticketTypeId": "{{soldOutTicket}}", "quantity": 1, "unitPrice": 5000 }
  ]
}


### 10. Setup — create a fresh order to fail its payment next
# @name createForFailedPayment
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": [
    { "ticketTypeId": "{{vipTicket}}", "quantity": 1, "unitPrice": 5000 }
  ]
}


### 11. Pay the order from #10 with a failing token — 409 PaymentFailed
# Any token starting with "fail-" triggers deterministic failure in FakePaymentGateway
POST {{baseUrl}}/orders/{{createForFailedPayment.response.body.id}}/pay
Content-Type: {{contentType}}

{
  "paymentToken": "fail-bad-card",
  "paymentMethod": "pix"
}


### 12. Pay a non-existent order — 404 OrderNotFound
POST {{baseUrl}}/orders/00000000-0000-0000-0000-000000000000/pay
Content-Type: {{contentType}}

{
  "paymentToken": "tok_test_123",
  "paymentMethod": "credit_card"
}


### 13. Create an order with empty items array — 400 Bad Request (DTO @ArrayMinSize)
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "items": []
}


### 14. Create an order with an extra property — 400 Bad Request (DTO forbidNonWhitelisted)
POST {{baseUrl}}/orders
Content-Type: {{contentType}}

{
  "eventId": "{{openEvent}}",
  "attendeeId": "{{attendeeId}}",
  "maliciousField": "should be rejected",
  "items": [
    { "ticketTypeId": "{{vipTicket}}", "quantity": 1, "unitPrice": 5000 }
  ]
}


### 15. Pay with an invalid payment method — 400 Bad Request (DTO @IsIn)
# Reuses the order id from #1
POST {{baseUrl}}/orders/{{createOrder.response.body.id}}/pay
Content-Type: {{contentType}}

{
  "paymentToken": "tok_test_123",
  "paymentMethod": "bitcoin"
}
